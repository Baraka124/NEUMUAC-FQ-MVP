{
  "name": "@neumuac-fq/clinical-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "test:e2e:contract": "playwright test --config playwright.contract.config.ts",
    "test:differential": "tsx tests/compare.mts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "vue": "3.5.18",
    "vue-router": "4.5.1",
    "pinia": "3.0.3",
    "@supabase/supabase-js": "2.57.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@vitejs/plugin-vue": "6.0.1",
    "typescript": "5.9.2",
    "vite": "7.1.5",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.0",
    "@playwright/test": "1.56.1",
    "tsx": "4.20.5"
  }
}
