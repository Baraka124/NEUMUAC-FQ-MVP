# The new Vue interface will show no variants without configuration.
# Use only an explicitly approved read-only source and public/publishable key.
# RLS and grants, not a public API key, enforce authorization.
VITE_NFQ_READ_ONLY_ENABLED=false
VITE_NFQ_SUPABASE_URL=
VITE_NFQ_SUPABASE_PUBLISHABLE_KEY=

# Public catalog browsing is read-only. Enable ONLY after the restricted
# five-column catalog has been deployed and anonymous writes are denied by RLS.
# Staff login uses a separate Supabase session and does not alter public reads.
VITE_NFQ_READ_ACCESS_MODE=anonymous

# The restricted catalog must be deployed and permitted before enabling reads.
# No fallback to public.variants exists.

# Source-correction RPC is NOT deployed by default. Keep disabled until the
# separate database migration, verified administrator bootstrap, RLS/RPC
# security checks, and production acceptance tests have been completed.
# This client-side flag does not grant permissions; the database enforces roles.
VITE_NFQ_SOURCE_CORRECTIONS_ENABLED=false

# Read-only scientific source-correction review queue. Disabled until the
# 14H105 schema is deployed, memberships are verified, and RLS is tested.
# This flag does not authorize reviews or enable any approval operation.
VITE_NFQ_SOURCE_REVIEW_QUEUE_ENABLED=false
